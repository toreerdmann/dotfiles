def get_installed_monospace_fonts() -> list[str]:
    fonts = set()
    try:
        res = subprocess.run(["ghostty", "+list-fonts"], capture_output=True, text=True, check=False)
        for line in res.stdout.splitlines():
            if line and not line.startswith(" ") and not line.startswith("\t"):
                font_name = line.strip()
                fonts.add(font_name)
    except Exception:
        pass

    for builtin in ["Menlo", "Monaco", "Courier New"]:
        fonts.add(builtin)

    return sorted(fonts)


def get_current_font() -> str:
    if os.path.isfile(GHOSTTY_CONFIG):
        try:
            with open(GHOSTTY_CONFIG, "r", encoding="utf-8") as f:
                for line in f:
                    m = re.match(r"^\s*font-family\s*=\s*(.+)$", line)
                    if m:
                        val = m.group(1).strip()
                        if val and not val.startswith("#"):
                            return val
        except Exception:
            pass
    if os.path.isfile(FONT_JSON):
        try:
            with open(FONT_JSON, "r", encoding="utf-8") as f:
                data = json.load(f)
                return data.get("font", "Iosevka")
        except Exception:
            pass
    return "Iosevka"


def render_preview(font_name: str):
    installed_fonts = get_installed_monospace_fonts()
    is_installed = font_name in installed_fonts
    curr = " (CURRENT)" if font_name == get_current_font() else ""

    info = CURATED_FONTS.get(font_name, {})
    desc = info.get("desc", "Monospace programming font.")
    traits = info.get("traits", "Monospace")
    cask = info.get("cask")

    if is_installed:
        status = "\033[1;32m✓ Installed on system\033[0m"
    elif cask:
        status = f"\033[1;33m○ Available via Homebrew\033[0m (brew install --cask {cask})"
    else:
        status = "\033[1;31m✗ Not Installed\033[0m"

    # Header Card
    print(f"\033[1;36mTypeface:\033[0m \033[1m{font_name}\033[0m{curr}")
    print(f"\033[1mStatus:\033[0m   {status}")
    print(f"\033[1mTraits:\033[0m   \033[1;34m{traits}\033[0m")
    print(f"\033[2m{desc}\033[0m")
    print("\033[2m" + "─" * 48 + "\033[0m")

    # If specimen PNG exists or can be rendered, display with viu
    os.makedirs(PREVIEWS_DIR, exist_ok=True)
    specimen_path = os.path.join(PREVIEWS_DIR, f"{font_name}.png")

    if not os.path.isfile(specimen_path) and is_installed and os.path.isfile(RENDER_FONT_BIN):
        try:
            subprocess.run([RENDER_FONT_BIN, font_name, specimen_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1)
        except Exception:
            pass

    viu_bin = shutil.which("viu") or "/opt/homebrew/bin/viu"
    if os.path.isfile(specimen_path) and os.path.isfile(viu_bin):
        print("\033[1mVisual Specimen (Native Typeface):\033[0m")
        sys.stdout.flush()
        try:
            # Use viu to render the specimen image into Ghostty
            subprocess.run([viu_bin, "-w", "50", specimen_path], check=False)
        except Exception:
            pass
        print("\033[2m" + "─" * 48 + "\033[0m")
    else:
        # Fallback text representation
        print("\033[1mCharacter Sheet:\033[0m")
        print("ABCDEFGHIJKLMNOPQRSTUVWXYZ")
        print("abcdefghijklmnopqrstuvwxyz  0123456789")
        print("==  !=  <=  >=  =>  ->  <-  ::  ===  !==")
        print("\033[2m" + "─" * 48 + "\033[0m")


def reload_ghostty():
    """Trigger Ghostty's native Reload Configuration menu item on macOS."""
    try:
        subprocess.run([
            "osascript", "-e",
            'tell application "System Events" to tell process "Ghostty" to click menu item "Reload Configuration" of menu "Ghostty" of menu bar 1'
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1)
    except Exception:
        pass


def apply_ghostty_font(font_name: str):
    if not os.path.isfile(GHOSTTY_CONFIG):
        return

    real_path = os.path.realpath(GHOSTTY_CONFIG)
    try:
        with open(real_path, "r", encoding="utf-8") as f:
            lines = f.readlines()

        font_pattern = re.compile(r"^\s*font-family\s*=.*$")
        new_val = f"font-family = {font_name}\n"

        replaced = False
        new_lines = []
        for line in lines:
            if font_pattern.match(line):
                new_lines.append(new_val)
                replaced = True
            else:
                new_lines.append(line)

        if not replaced:
            new_lines.append("\n" + new_val)

        with open(real_path, "w", encoding="utf-8") as f:
            f.writelines(new_lines)
    except Exception as e:
        print(f"Warning: failed to update Ghostty font: {e}", file=sys.stderr)


def apply_alacritty_font(font_name: str):
    if not os.path.isfile(ALACRITTY_CONFIG):
        return

    real_path = os.path.realpath(ALACRITTY_CONFIG)
    try:
        with open(real_path, "r", encoding="utf-8") as f:
            content = f.read()

        new_content = re.sub(
            r'(family\s*=\s*)"[^"]+"',
            rf'\1"{font_name}"',
            content,
        )

        with open(real_path, "w", encoding="utf-8") as f:
            f.write(new_content)
    except Exception:
        pass


def install_font(cask_name: str) -> bool:
    print(f"\nInstalling font via Homebrew: brew install --cask {cask_name}...")
    proc = subprocess.run(["brew", "install", "--cask", cask_name])
    return proc.returncode == 0


def apply_font(font_name: str, auto_install: bool = False, verbose: bool = True):
    installed_fonts = get_installed_monospace_fonts()

    if font_name not in installed_fonts:
        info = CURATED_FONTS.get(font_name)
        if info and info.get("cask"):
            cask = info["cask"]
            if not auto_install:
                try:
                    ans = input(f"Font '{font_name}' is not installed. Install via Homebrew ({cask})? [y/N]: ").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    ans = "n"
            else:
                ans = "y"

            if ans in ("y", "yes"):
                if install_font(cask):
                    installed_fonts = get_installed_monospace_fonts()
                else:
                    print(f"Error: failed to install {cask}.", file=sys.stderr)
                    sys.exit(1)
            else:
                print("Aborted.")
                sys.exit(0)
        else:
            print(f"Error: Font '{font_name}' is not installed on this system.", file=sys.stderr)
            sys.exit(1)

    os.makedirs(THEME_DIR, exist_ok=True)
    with open(FONT_JSON, "w", encoding="utf-8") as f:
        json.dump({"font": font_name}, f, indent=2)

    apply_ghostty_font(font_name)
    apply_alacritty_font(font_name)
    reload_ghostty()

    if verbose:
        print(f"\033[1;32m✓\033[0m Switched font to \033[1m{font_name}\033[0m")
        print("  • Ghostty  : config updated & reloaded live")
        if os.path.isfile(ALACRITTY_CONFIG):
            print("  • Alacritty: config updated")


def list_fonts():
    installed = set(get_installed_monospace_fonts())
    current_font = get_current_font()

    print("\033[1mInstalled Monospace Fonts:\033[0m")
    for f in sorted(installed):
        mark = "\033[1;32m* (active)\033[0m" if f == current_font else ""
        print(f"  • {f} {mark}")

    not_installed = [name for name, info in CURATED_FONTS.items() if name not in installed and info.get("cask")]
    if not_installed:
        print("\n\033[1mPopular Coding Fonts Available via Homebrew:\033[0m")
        for f in not_installed:
            cask = CURATED_FONTS[f]["cask"]
            print(f"  ○ \033[1m{f:<24}\033[0m (brew install --cask {cask})")


def run_interactive_picker():
    fzf_bin = shutil.which("fzf")
    if not fzf_bin:
        local_fzf = os.path.expanduser("~/.local/share/mise/installs/fzf/latest/fzf")
        if os.path.isfile(local_fzf):
            fzf_bin = local_fzf

    if not fzf_bin or not sys.stdin.isatty():
        list_fonts()
        return

    script_path = os.path.abspath(__file__)
    current_font = get_current_font()
    installed = set(get_installed_monospace_fonts())

    items = []
    for f in sorted(installed):
        tag = "(current)" if f == current_font else "(installed)"
        items.append(f"{f}\t{tag}")

    for f, info in CURATED_FONTS.items():
        if f not in installed and info.get("cask"):
            items.append(f"{f}\t(available via brew)")

    input_data = "\n".join(items)

    fzf_cmd = [
        fzf_bin,
        "--ansi",
        "--delimiter=\t",
        "--prompt=Select font > ",
        "--height=65%",
        "--reverse",
        "--border",
        f"--preview={script_path} --preview {{1}}",
        "--preview-window=right:55%:wrap",
    ]

    try:
        proc = subprocess.run(fzf_cmd, input=input_data, capture_output=True, text=True)
        if proc.returncode == 0:
            selected = proc.stdout.split("\t")[0].strip()
            if selected:
                apply_font(selected, verbose=True)
    except KeyboardInterrupt:
        pass


def main():
    parser = argparse.ArgumentParser(
        description="Unified font switcher and visual previewer for Ghostty and Alacritty."
    )
    parser.add_argument("font", nargs="*", help="Font name to apply (or omit for interactive fuzzy picker)")
    parser.add_argument("-l", "--list", action="store_true", help="List installed and available monospace fonts")
    parser.add_argument("-c", "--current", action="store_true", help="Print current font name")
    parser.add_argument("--install", action="store_true", help="Auto-install font via Homebrew if needed")
    parser.add_argument("--preview", nargs="+", help=argparse.SUPPRESS)

    args = parser.parse_args()

    if args.preview:
        target = " ".join(args.preview).strip()
        render_preview(target)
        return

    if args.current:
        print(get_current_font())
        return

    if args.list:
        list_fonts()
        return

    if args.font:
        target = " ".join(args.font).strip()
        apply_font(target, auto_install=args.install)
    else:
        run_interactive_picker()


if __name__ == "__main__":
    main()
