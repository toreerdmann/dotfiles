#!/usr/bin/env python3
"""
font-switch: Monospace & Nerd Font switcher and graphical previewer for Ghostty and Alacritty.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(HOME, ".config")
THEME_DIR = os.path.join(CONFIG_DIR, "theme")
FONT_JSON = os.path.join(THEME_DIR, "font.json")
PREVIEWS_DIR = os.path.join(THEME_DIR, "font_previews")
GHOSTTY_CONFIG = os.path.join(CONFIG_DIR, "ghostty", "config")
ALACRITTY_CONFIG = os.path.join(CONFIG_DIR, "alacritty", "alacritty.toml")
RENDER_FONT_BIN = os.path.join(os.path.dirname(os.path.abspath(__file__)), "render_font")

CURATED_FONTS = {
