#!/usr/bin/env python3
"""
font-switch: Monospace & Nerd Font switcher and live previewer for Ghostty and Alacritty.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(HOME, ".config")
THEME_DIR = os.path.join(CONFIG_DIR, "theme")
FONT_JSON = os.path.join(THEME_DIR, "font.json")
GHOSTTY_CONFIG = os.path.join(CONFIG_DIR, "ghostty", "config")
ALACRITTY_CONFIG = os.path.join(CONFIG_DIR, "alacritty", "alacritty.toml")

CURATED_FONTS = {
    "Iosevka": {
        "cask": "font-iosevka",
        "desc": "Slender, condensed, highly readable typeface designed for programming.",
    },
    "Iosevka Fixed": {
        "cask": "font-iosevka",
        "desc": "Iosevka variant with strictly fixed-width characters and no ligatures.",
    },
    "Iosevka Term": {
        "cask": "font-iosevka",
        "desc": "Terminal-optimized Iosevka variant with standard cell dimensions.",
    },
    "Iosevka Nerd Font Mono": {
        "cask": "font-iosevka-nerd-font",
        "desc": "Iosevka patched with complete Nerd Font developer glyphs and symbols.",
    },
    "JetBrains Mono": {
