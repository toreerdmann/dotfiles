HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(HOME, ".config")
THEME_DIR = os.path.join(CONFIG_DIR, "theme")
CURRENT_JSON = os.path.join(THEME_DIR, "current.json")
TMUX_THEME_CONF = os.path.join(THEME_DIR, "tmux.conf")
BASE16_SH = os.path.join(THEME_DIR, "base16.sh")
BASE16_FISH = os.path.join(THEME_DIR, "base16.fish")
BASE16_JSON = os.path.join(THEME_DIR, "base16.json")
GHOSTTY_CONFIG = os.path.join(CONFIG_DIR, "ghostty", "config")


def get_current_theme_name() -> str:
    if os.path.isfile(CURRENT_JSON):
        try:
            with open(CURRENT_JSON, "r") as f:
                data = json.load(f)
                return data.get("theme", "catppuccin")
        except Exception:
            pass
    return "catppuccin"


def is_mac_dark_mode() -> bool:
    try:
        res = subprocess.run(
            ["defaults", "read", "-g", "AppleInterfaceStyle"],
            capture_output=True,
            text=True,
            check=False,
        )
        return "dark" in res.stdout.lower()
    except Exception:
        return True


def hex_to_rgb(hex_str: str):
    h = hex_str.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def color_block(hex_str: str) -> str:
    r, g, b = hex_to_rgb(hex_str)
    return f"\033[48;2;{r};{g};{b}m  \033[0m"


def render_preview(theme_key: str):
    if theme_key not in THEMES:
        print(f"Unknown theme: {theme_key}")
        return

    data = THEMES[theme_key]
    curr = " (CURRENT)" if theme_key == get_current_theme_name() else ""

    print(f"\033[1;36mTheme:\033[0m \033[1m{data['display']}\033[0m{curr}")
    print("\033[2m" + "─" * 48 + "\033[0m")
    print(f"\033[1;33m🌙 Dark Mode:\033[0m")
    print(f"   Ghostty : {data['dark']['ghostty']}")
    print(f"   Neovim  : {data['dark']['nvim']}")
    print(f"   Tmux Bg : {data['dark']['tmux_bg']}")
    print(f"   Delta   : {data['dark']['delta']}")
    # Render base16 dark palette swatch blocks
    dark_b16 = data['dark']['base16']
    swatches_row1 = "".join(color_block(dark_b16[f"base0{i:X}"]) for i in range(8))
    swatches_row2 = "".join(color_block(dark_b16[f"base0{i:X}"]) for i in range(8, 16))
    print(f"   Base16  : {swatches_row1} (00-07)")
    print(f"             {swatches_row2} (08-0F)")
    print()
    print(f"\033[1;35m☀️  Light Mode:\033[0m")
    print(f"   Ghostty : {data['light']['ghostty']}")
    print(f"   Neovim  : {data['light']['nvim']}")
    print(f"   Tmux Bg : {data['light']['tmux_bg']}")
    print(f"   Delta   : {data['light']['delta']}")
    light_b16 = data['light']['base16']
    swatches_l1 = "".join(color_block(light_b16[f"base0{i:X}"]) for i in range(8))
    swatches_l2 = "".join(color_block(light_b16[f"base0{i:X}"]) for i in range(8, 16))
    print(f"   Base16  : {swatches_l1} (00-07)")
    print(f"             {swatches_l2} (08-0F)")
    print("\033[2m" + "─" * 48 + "\033[0m")


def apply_ghostty_theme(theme_data: dict):
    if not os.path.isfile(GHOSTTY_CONFIG):
        return

    real_path = os.path.realpath(GHOSTTY_CONFIG)
    try:
        with open(real_path, "r", encoding="utf-8") as f:
            lines = f.readlines()

        new_val = f"theme = dark:{theme_data['dark']['ghostty']},light:{theme_data['light']['ghostty']}\n"
        theme_pattern = re.compile(r"^\s*theme\s*=.*$")

        replaced = False
        new_lines = []
        for line in lines:
            if theme_pattern.match(line):
                new_lines.append(new_val)
                replaced = True
            else:
                new_lines.append(line)

        if not replaced:
            new_lines.append("\n" + new_val)

        with open(real_path, "w", encoding="utf-8") as f:
            f.writelines(new_lines)
    except Exception as e:
        print(f"Warning: failed to update Ghostty config: {e}", file=sys.stderr)


def apply_tmux_theme(theme_data: dict):
    os.makedirs(THEME_DIR, exist_ok=True)
    content = (
        "# Auto-generated by theme-switch. Do not edit directly.\n"
        "if-shell 'defaults read -g AppleInterfaceStyle 2>/dev/null | grep -q \"Dark\"' \\\n"
        f"    \"set -g @minimal-tmux-bg '{theme_data['dark']['tmux_bg']}'; set -g @catppuccin_flavor '{theme_data['dark']['tmux_flavor']}'\" \\\n"
        f"    \"set -g @minimal-tmux-bg '{theme_data['light']['tmux_bg']}'; set -g @catppuccin_flavor '{theme_data['light']['tmux_flavor']}'\"\n"
    )
    with open(TMUX_THEME_CONF, "w", encoding="utf-8") as f:
        f.write(content)

    try:
        tmux_check = subprocess.run(["tmux", "info"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if tmux_check.returncode == 0:
            tmux_conf = os.path.join(HOME, ".tmux.conf")
            subprocess.run(["tmux", "source-file", tmux_conf], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["tmux", "refresh-client", "-S"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def apply_base16(theme_key: str, theme_data: dict):
    os.makedirs(THEME_DIR, exist_ok=True)
    dark_mode = is_mac_dark_mode()
    mode_key = "dark" if dark_mode else "light"
    palette = theme_data[mode_key]["base16"]

    # 1. Write base16.json
    with open(BASE16_JSON, "w", encoding="utf-8") as f:
        json.dump({
            "theme": theme_key,
            "mode": mode_key,
            "palette": palette,
            "dark": theme_data["dark"]["base16"],
            "light": theme_data["light"]["base16"],
        }, f, indent=2)

    # 2. Write base16.sh (bash / zsh)
    sh_lines = [
        f'# Base16 configuration for {theme_data["display"]}',
        f'export BASE16_THEME="{theme_key}"',
    ]
    for key, hex_val in palette.items():
        sh_lines.append(f'export BASE16_COLOR_{key[-2:]}_HEX="{hex_val}"')

    # FZF base16 styling
    b00 = palette["base00"]
    b01 = palette["base01"]
    b05 = palette["base05"]
    b06 = palette["base06"]
    b0A = palette["base0A"]
    b0C = palette["base0C"]
    b0D = palette["base0D"]

    fzf_colors = (
        f'--color=bg+:{b01},bg:{b00},spinner:{b0C},hl:{b0D} '
        f'--color=fg:{b05},header:{b0D},info:{b0A},pointer:{b0C} '
        f'--color=marker:{b0C},fg+:{b06},prompt:{b0A},hl+:{b0D}'
    )
    sh_lines.append(f'export FZF_BASE16_OPTS="{fzf_colors}"')
    with open(BASE16_SH, "w", encoding="utf-8") as f:
        f.write("\n".join(sh_lines) + "\n")

    # 3. Write base16.fish (fish)
    fish_lines = [
        f'# Base16 configuration for {theme_data["display"]}',
        f'set -gx BASE16_THEME "{theme_key}"',
    ]
    for key, hex_val in palette.items():
        fish_lines.append(f'set -gx BASE16_COLOR_{key[-2:]}_HEX "{hex_val}"')
    fish_lines.append(f'set -gx FZF_BASE16_OPTS "{fzf_colors}"')
    with open(BASE16_FISH, "w", encoding="utf-8") as f:
        f.write("\n".join(fish_lines) + "\n")

    # 4. Emit OSC 4/10/11 color palette sequences to tty if connected
    # Mapping Base16 to 16 ANSI colors:
    # 0: base00 (Black)
    # 1: base08 (Red)
    # 2: base0B (Green)
    # 3: base0A (Yellow)
    # 4: base0D (Blue)
    # 5: base0E (Magenta)
    # 6: base0C (Cyan)
    # 7: base05 (White)
    # 8: base03 (Bright Black)
    # 9: base08 (Bright Red)
    # 10: base0B (Bright Green)
    # 11: base0A (Bright Yellow)
    # 12: base0D (Bright Blue)
    # 13: base0E (Bright Magenta)
    # 14: base0C (Bright Cyan)
    # 15: base07 (Bright White)
    ansi_map = {
        0: palette["base00"], 1: palette["base08"], 2: palette["base0B"], 3: palette["base0A"],
        4: palette["base0D"], 5: palette["base0E"], 6: palette["base0C"], 7: palette["base05"],
        8: palette["base03"], 9: palette["base08"], 10: palette["base0B"], 11: palette["base0A"],
        12: palette["base0D"], 13: palette["base0E"], 14: palette["base0C"], 15: palette["base07"],
    }
    osc_seqs = "".join(f"\033]4;{idx};{color}\007" for idx, color in ansi_map.items())
    osc_seqs += f"\033]10;{palette['base05']}\007"  # Foreground
    osc_seqs += f"\033]11;{palette['base00']}\007"  # Background

    for tty_candidate in ["/dev/tty"]:
        try:
            with open(tty_candidate, "wb") as tty:
                tty.write(osc_seqs.encode("utf-8"))
                tty.flush()
            break
        except Exception:
            pass


def apply_neovim_theme(theme_data: dict):
    dark_mode = is_mac_dark_mode()
    target_scheme = theme_data["dark"]["nvim"] if dark_mode else theme_data["light"]["nvim"]

    search_dirs = [
        tempfile.gettempdir(),
        "/tmp",
        os.path.join(HOME, ".local", "state", "nvim"),
    ]
    sockets = []
    for sdir in search_dirs:
        sockets.extend(glob.glob(os.path.join(sdir, "nvim*/*")))
        sockets.extend(glob.glob(os.path.join(sdir, "nvim*.0")))

    for sock in set(sockets):
        if os.path.exists(sock):
            try:
                subprocess.run(
                    ["nvim", "--server", sock, "--remote-send", f"<Esc>:colorscheme {target_scheme}<CR>"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=0.5,
                )
            except Exception:
                pass


def apply_delta_theme(theme_data: dict):
    dark_mode = is_mac_dark_mode()
    delta_feature = theme_data["dark"]["delta"] if dark_mode else theme_data["light"]["delta"]
    if delta_feature:
        try:
            subprocess.run(["git", "config", "--global", "delta.features", delta_feature], check=False)
        except Exception:
            pass


def apply_theme(theme_key: str):
    if theme_key not in THEMES:
        print(f"Error: Unknown theme '{theme_key}'.", file=sys.stderr)
        print(f"Available themes: {', '.join(THEMES.keys())}", file=sys.stderr)
        sys.exit(1)

    theme_data = THEMES[theme_key]
    os.makedirs(THEME_DIR, exist_ok=True)

    state = {
        "theme": theme_key,
        "display": theme_data["display"],
        "dark": theme_data["dark"],
        "light": theme_data["light"],
    }
    with open(CURRENT_JSON, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)

    apply_ghostty_theme(theme_data)
    apply_tmux_theme(theme_data)
    apply_base16(theme_key, theme_data)
    apply_neovim_theme(theme_data)
    apply_delta_theme(theme_data)

    print(f"\033[1;32m✓\033[0m Switched theme to \033[1m{theme_data['display']}\033[0m")
    print("  • Ghostty  : reloaded")
    print("  • Tmux     : updated")
    print("  • Base16   : exported (OSC sequences, FZF, and shell env)")
    print("  • Neovim   : synced")
    print("  • Git delta: configured")


def run_interactive_picker():
    fzf_bin = shutil.which("fzf")
    if not fzf_bin:
        local_fzf = os.path.expanduser("~/.local/share/mise/installs/fzf/latest/fzf")
        if os.path.isfile(local_fzf):
            fzf_bin = local_fzf

    if not fzf_bin or not sys.stdin.isatty():
        list_themes()
        return

    script_path = os.path.abspath(__file__)
    current_theme = get_current_theme_name()
    input_lines = "\n".join(
        f"{k} {'(current)' if k == current_theme else ''}".strip()
        for k in THEMES.keys()
    )

    fzf_cmd = [
        fzf_bin,
        "--ansi",
        "--prompt=Select theme > ",
        "--height=50%",
        "--reverse",
        "--border",
        f"--preview={script_path} --preview {{1}}",
        "--preview-window=right:55%:wrap",
    ]

    try:
        proc = subprocess.run(fzf_cmd, input=input_lines, capture_output=True, text=True)
        if proc.returncode == 0:
            selected = proc.stdout.strip().split()[0]
            if selected in THEMES:
                apply_theme(selected)
    except KeyboardInterrupt:
        pass


def list_themes():
    current_theme = get_current_theme_name()
    print("\033[1mAvailable Themes:\033[0m")
    for key, val in THEMES.items():
        mark = "\033[1;32m* (active)\033[0m" if key == current_theme else ""
        print(f"  • \033[1m{key:<12}\033[0m - {val['display']} {mark}")
    print("\nUsage:")
    print("  theme-switch <theme-name>    Switch directly")
    print("  theme-switch                 Interactive fuzzy picker")


def main():
    # Direct delegation to font-switch if 'font' or '--font' is used
    if len(sys.argv) > 1 and sys.argv[1] == "font":
        font_switch_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "font-switch")
        sys.exit(subprocess.run([sys.executable, font_switch_bin] + sys.argv[2:]).returncode)

    if len(sys.argv) > 1 and sys.argv[1] in ("-f", "--font"):
        font_switch_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "font-switch")
        sys.exit(subprocess.run([sys.executable, font_switch_bin] + sys.argv[2:]).returncode)

    parser = argparse.ArgumentParser(
        description="Unified cross-tool theme switcher for Ghostty, Neovim, Tmux, Git Delta, and Base16."
    )
    parser.add_argument("theme", nargs="?", help="Theme name to apply (or omit for interactive picker)")
    parser.add_argument("-l", "--list", action="store_true", help="List available themes")
    parser.add_argument("-c", "--current", action="store_true", help="Print current active theme name")
    parser.add_argument("--preview", help=argparse.SUPPRESS)

    args = parser.parse_args()

    if args.preview:
        render_preview(args.preview)
        return

    if args.current:
        print(get_current_theme_name())
        return

    if args.list:
        list_themes()
        return

    if args.theme:
        apply_theme(args.theme)
    else:
        run_interactive_picker()


if __name__ == "__main__":
    main()
